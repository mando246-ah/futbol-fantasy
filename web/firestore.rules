rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Helpers */
    function authed() { return request.auth != null; }
    function isOwner() {
      return authed() && request.auth.uid == "WspA06q2KlQr7KUq2PP58FMyIJk2";
    }
    function roomDoc(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)); }
    function isHostUid(roomId) {
      return authed() && roomDoc(roomId).data.hostUid == request.auth.uid;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }
    function isRoomMember(roomId) {
      return authed() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function inUserRoom(roomId) {
      return authed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/rooms/$(roomId));
    }
    function canReadRoomHistory(roomId) {
      return authed() && (
        isHostUid(roomId) ||
        isRoomMember(roomId) ||
        inUserRoom(roomId)
      );
    }
    function isWorldCupDailyRoom(roomId) {
      let room = roomDoc(roomId).data;
      return room.get('engineType', '') == 'worldCupDaily'
        || room.get('worldCup', {}).get('engineType', '') == 'worldCupDaily'
        || room.get('worldCupPhase', '') == 'group'
        || room.get('competitionState', {}).get('phaseLabel', '') == 'WorldCupGroup';
    }


    /* users */
    match /users/{uid} {
      allow read: if authed();
      allow create, update: if authed() && uid == request.auth.uid;
      allow delete: if false;
    }
    match /users/{uid}/rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // User can save a room before draft starts.
      // Existing saved rooms can still update lastSeenAt later.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && (
          roomDoc(roomId).data.started == false ||
          exists(/databases/$(database)/documents/users/$(uid)/rooms/$(roomId))
        );

      // User can remove it from their own list.
      // Host can remove it when kicking someone.
      allow delete: if request.auth != null
        && (
          request.auth.uid == uid ||
          isHostUid(roomId)
        );
    }

    match /sitePresence/{uid} {
      allow read: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /adminErrors/{errorId} {
      allow read, update: if isOwner();
      allow create, delete: if false;
    }

    /*user changing team name*/
    match /rooms/{roomId}/teamNames/{uid} {
      allow read: if authed(); // ideally also check user is in room
      allow create, update: if authed() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /rooms/{roomId}/lineups/{uid} {
      allow read: if authed();
      // World Cup daily lineups must go through callable validation so appearance
      // locks cannot be bypassed with a direct client write.
      allow create, update: if authed()
        && !isWorldCupDailyRoom(roomId)
        && (request.auth.uid == uid || isHostUid(roomId));
      allow delete: if false;
    }


    /* rooms + subcollections */
    match /rooms/{roomId} {
      allow read: if authed();
      allow create: if authed() && request.resource.data.hostUid == request.auth.uid;

      // Host can update anything.
      // Non-hosts can:
      //  - Join/leave: change only 'members' (+ updatedAt)
      //  - Make a pick: change only 'turnIndex' & 'turnDeadlineAt' (+ updatedAt)
      // Host-only can:
      //  - Update market field on the room doc: change only 'market' (+ updatedAt)
      allow update: if authed() && (
        isHostUid(roomId) ||

        // Users can only join/leave/edit members BEFORE the draft starts.
        (
          resource.data.started == false &&
          request.resource.data.started == false &&
          changedOnly(['members', 'updatedAt'])
        ) ||

        changedOnly(['turnIndex','turnDeadlineAt','updatedAt']) ||
        (isHostUid(roomId) && changedOnly(['name', 'updatedAt'])) ||
        (isHostUid(roomId) && changedOnly(['market','updatedAt']))
      );

      allow delete: if false;
      
      // tournament weeks (created by Cloud Functions)
        match /weeks/{weekId} {
          allow read: if authed();
          allow write: if false;
        }
        match /weekResults/{weekId} {
          allow read: if authed();
          allow write: if false;
        }

        // World Cup Group Stage daily windows/results.
        // Written only by Cloud Functions/Admin SDK.
        match /days/{dayId} {
          allow read: if canReadRoomHistory(roomId);
          allow write: if false;
        }

        match /dayResults/{dayId} {
          allow read: if canReadRoomHistory(roomId);
          allow write: if false;
        }

        match /standings/{docId} {
          allow read: if authed();
          allow write: if false;
        }
        match /roundResults/{roundId} {
          allow read: if authed();
          allow write: if false; // (Cloud Functions can still write via Admin SDK)
        }
        // Cup docs
        match /cup/{docId} {
          allow read: if isRoomMember(roomId);
          allow write: if false; // Cloud Functions/Admin SDK can still write
        }

        // Cup fixture ledger
        match /cup/{docId}/fixtures/{fixtureId} {
          allow read: if isRoomMember(roomId);
          allow write: if false; // Cloud Functions/Admin SDK can still write
        }

        // Final results snapshot
        match /finalResults/{docId} {
          allow read: if isRoomMember(roomId);
          allow write: if false; // Cloud Functions/Admin SDK can still write
        }

        match /cupHistory/{docId} {
          allow read: if isRoomMember(roomId);
          allow write: if false;
        }



      // ✅ market doc (Marketplace.jsx reads: rooms/{roomId}/market/current)
      match /market/{docId} {
        allow read: if authed();
        // choose one:

        // Option A (common): only host can write from client
        allow create, update, delete: if authed() && isHostUid(roomId);

        // Option B (stricter): ONLY Cloud Functions (Admin SDK) can write
        // allow create, update, delete: if false;
      }

      // presence mirror (optional)
      match /members/{uid} {
        allow read: if authed();

        // Users can add/update their own member mirror only before draft starts.
        allow create, update: if authed()
          && uid == request.auth.uid
          && roomDoc(roomId).data.started == false;

        // User can leave before start, or host can kick before start.
        allow delete: if authed()
          && roomDoc(roomId).data.started == false
          && (
            uid == request.auth.uid ||
            isHostUid(roomId)
          );
      }

      // Temporary room chat: latest messages are client-readable only by members.
      match /chatMessages/{messageId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
          && request.resource.data.keys().hasAll([
            'roomId',
            'uid',
            'displayName',
            'text',
            'mediaType',
            'mediaUrl',
            'mediaPath',
            'mediaMime',
            'mediaSize',
            'createdAt',
            'createdAtMs',
            'deleted'
          ])
          && request.resource.data.keys().hasOnly([
            'roomId',
            'uid',
            'displayName',
            'text',
            'mediaType',
            'mediaUrl',
            'mediaPath',
            'mediaMime',
            'mediaSize',
            'createdAt',
            'createdAtMs',
            'deleted'
          ])
          && request.resource.data.roomId == roomId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && (
              request.resource.data.text.size() > 0 ||
              request.resource.data.mediaType != null
            )
          && (
            request.resource.data.mediaType == null ||
            request.resource.data.mediaType == 'image' ||
            request.resource.data.mediaType == 'gif'
          )
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() <= 2000
          && request.resource.data.mediaPath is string
          && request.resource.data.mediaPath.size() <= 500
          && request.resource.data.mediaMime is string
          && request.resource.data.mediaMime.size() <= 40
          && request.resource.data.mediaSize is int
          && request.resource.data.mediaSize >= 0
          && request.resource.data.mediaSize <= 10 * 1024 * 1024
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtMs is int
          && request.resource.data.createdAtMs >= request.time.toMillis() - 5 * 60 * 1000
          && request.resource.data.createdAtMs <= request.time.toMillis() + 5 * 60 * 1000
          && request.resource.data.createdAtMs is number
          && request.resource.data.createdAtMs > 0
          && request.resource.data.deleted == false
          && (
            request.resource.data.text.size() > 0 ||
            request.resource.data.mediaType != null
          )
          && (
            (
              request.resource.data.mediaType == null
              && request.resource.data.mediaUrl == ''
              && request.resource.data.mediaPath == ''
              && request.resource.data.mediaMime == ''
              && request.resource.data.mediaSize == 0
            ) ||
            (
              request.resource.data.mediaType != null
              && request.resource.data.mediaUrl.size() > 0
              && request.resource.data.mediaPath.matches(
                'rooms/' + roomId + '/chatMedia/' + messageId + '/.*'
              )
              && request.resource.data.mediaMime.matches(
                '^image/(jpeg|png|webp|gif)$'
              )
              && request.resource.data.mediaSize > 0
            )
          );

        allow update, delete: if false;
      }

      // Player pool is host-managed and readable by signed-in users.
      match /players/{playerId} {
        allow read: if authed();
        allow create, update, delete: if authed() && isHostUid(roomId);
      }

      // picks — allow any signed-in user to create (your app logic enforces whose turn it is)
      // host may update/delete (resolve/rollback + apply trades)
      match /picks/{pickId} {
        allow read: if authed();
        allow create: if authed();
        allow update, delete: if authed() && isHostUid(roomId);
      }

      // market interest — per-user doc
      match /marketInterest/{uid} {
        allow read: if authed();
  			allow create, update: if authed() && request.auth.uid == uid;
  			allow delete: if authed() && (request.auth.uid == uid || isHostUid(roomId));
      }

      // Market history is readable by room members; writes remain host-only.
      match /marketResults/{id} {
        allow read: if canReadRoomHistory(roomId);
        allow create, update, delete: if authed() && isHostUid(roomId);
      }

      // Room members can read all offers/history; write permissions stay scoped.
      match /trades/{tradeId} {
        allow read: if canReadRoomHistory(roomId);

        // sender creates offer
        allow create: if authed() && request.auth.uid == request.resource.data.fromUid;

        // update:
        // - sender can cancel pending
        // - recipient can accept/reject pending
        // - host can complete (apply) accepted trades
        allow update: if authed() && (
          isHostUid(roomId) ||
          (
            request.auth.uid == resource.data.fromUid &&
            resource.data.status == "pending" &&
            request.resource.data.status == "canceled"
          ) ||
          (
            request.auth.uid == resource.data.toUid &&
            resource.data.status == "pending" &&
            (
              request.resource.data.status == "accepted" ||
              request.resource.data.status == "rejected"
            )
          )
        );

        allow delete: if false;
      }
    }
  }
}
